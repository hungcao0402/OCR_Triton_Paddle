name: "OCRv5_det"
platform: "tensorrt_plan"
max_batch_size: 1
default_model_filename: "det.plan"

input [
  {
    name: "x"       
    data_type: TYPE_FP32
    dims: [ 3, -1, -1 ]
  }
]
output [
  {
    name: "fetch_name_0"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1 ]
  }
]
instance_group [
  {
    kind: KIND_GPU
    count: 2
  }
]
